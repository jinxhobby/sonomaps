    </div>
  </div>

  <!-- Studio Drawer -->
  <div id="studio-panel">
    <div class="studio-header">
      <div>
        <h3>Creator Studio</h3>
        <span style="font-size:11px; color:#cbd5e1;">Local Project Workspace</span>
      </div>
    </div>
    <div style="font-size:12px; color:#e2e8f0; margin-bottom:12px; font-weight: 600;">Add sound zones & modify audio stems:</div>
    <div class="btn-row">
      <button id="draw-poly-btn" class="btn-studio btn-purple">+ Draw Polygon</button>
      <button id="draw-circle-btn" class="btn-studio btn-green">+ Draw Circle</button>
    </div>
    
    <div id="zone-studio-list"></div>
  </div>

  <!-- Save/Export Modal -->
  <div id="save-modal" class="modal-overlay">
    <div class="modal-box">
      <h3 style="margin-bottom: 6px;">Save & Share Project</h3>
      <p style="font-size:12px; color:#94a3b8; margin-bottom: 16px;">Download locally or publish to the cloud to share links.</p>
      
      <div class="form-group" style="margin-bottom: 20px;">
        <label>Project Title</label>
