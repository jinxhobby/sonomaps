        <div style="font-size:11px; color:#38bdf8; font-weight:800; margin-bottom: 10px; text-transform:uppercase;">Publish & Share Link</div>
        <div style="display: flex; gap: 8px; margin-bottom: 4px;">
          <button class="save-option-btn btn-cloud-save" id="btn-publish-share" style="margin:0; flex:1; font-size:13px; padding: 10px;">☁️ Publish to Sonomaps Cloud</button>
        </div>
      </div>

      <!-- Local Backup Area -->
      <button class="save-option-btn btn-local-save" id="btn-download-sonomap">💾 Download .sonomap Bundle</button>
      
      <div style="text-align: center; margin-top: 18px;">
